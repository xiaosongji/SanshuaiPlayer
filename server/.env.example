# Copy this file to the same directory as the production Compose file and name
# it `.env`. Keep the real values on the NAS only; `server/.env` is gitignored.
MUSIC_DIRECTORY=/path/to/your/music
OWNMUSIC_DATA_DIRECTORY=/path/to/ownmusic/data
NAVIDROME_DATA_DIRECTORY=/path/to/navidrome/data
MUSIC_HOSTNAME=music.example.com
NAVIDROME_HOSTNAME=navidrome.example.com
ACME_EMAIL=admin@example.com
CERT_HOSTNAME=music.example.com

ARTIST_NAME=Library Owner
PUBLIC_BASE_URL=https://music.example.com
SIGNING_SECRET=replace-with-a-long-random-secret
API_USERNAME=replace-with-service-user
API_PASSWORD=replace-with-a-long-random-password

LASTFM_API_KEY=replace-with-lastfm-api-key
LASTFM_SHARED_SECRET=replace-with-lastfm-shared-secret

# Optional: only when using compose.fnos-tunnel.yml.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
